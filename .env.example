# ── Frontend env. Copy to .env — Vite only exposes VITE_-prefixed vars. ──
#
# Anything here ships to the browser in the built bundle. The anon key is
# designed to be public (Row Level Security is what protects your data).
# NEVER put the Supabase service role key in this file — that one is
# backend-only and lives in backend/.env.

# Where the FastAPI backend runs. Used by the Vite dev proxy (vite.config.ts).
# Leave as-is unless a teammate runs the backend on a different port.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# --- Supabase (browser-side auth) -------------------------------------------
# Dashboard > Settings > API. Leave both blank to run without login while
# the backend has DISABLE_AUTH=true.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
