# ── Copy to .env and fill in. .env is gitignored — never commit real keys. ──

# --- Dev switches -----------------------------------------------------------
# DISABLE_AUTH=true lets the frontend talk to the API without a Supabase login.
# Every request is treated as the fixed DEV_USER_ID below.
# NEVER set this to true on a deployed/public instance.
DISABLE_AUTH=true
DEV_USER_ID=00000000-0000-0000-0000-000000000000

# USE_MOCK_MODEL=true returns randomised predictions instead of running the
# real model. Lets the whole stack run before the trained checkpoint exists.
# Leave unset/false once you have fusion_model.pt in place.
USE_MOCK_MODEL=true

# --- Supabase ---------------------------------------------------------------
# Leave blank while DISABLE_AUTH=true — reports just won't persist.
# Dashboard > Settings > API for the first two, > JWT Keys for the secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Model ------------------------------------------------------------------
# The checkpoint train.py saves (outputs/models/fusion_model.pt in the
# training repo). Copy it to backend/checkpoints/fusion_model.pt.
FUSION_MODEL_CHECKPOINT=checkpoints/fusion_model.pt

# tiny | base | small | medium — smaller is faster, less accurate.
WHISPER_MODEL_SIZE=base

# cpu | cuda — set to cuda once you're on the GPU box.
DEVICE=cpu
INFERENCE_WORKERS=2

# Bytes of 16kHz mono PCM16 to buffer before running one live prediction.
# 128000 = ~4 seconds.
CHUNK_THRESHOLD_BYTES=128000
